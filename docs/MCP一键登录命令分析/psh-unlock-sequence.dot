digraph G {
  fontname="Noto Sans CJK SC";
  graph [fontname="Noto Sans CJK SC", label="PSH 解锁时序（debug → 密钥 → 解锁成功）", labelloc="t",
         fontsize=16, fontcolor="#1F2933", bgcolor="white", nodesep=1.2, ranksep=0.3];
  node [fontname="Noto Sans CJK SC", shape=box, style="rounded,filled",
        fillcolor="#F7F9FC", color="#7A93BE", fontcolor="#1F2933", fontsize=11];
  edge [fontname="Noto Sans CJK SC", color="#5A5A5A", fontcolor="#333333", fontsize=10];

  // 参与者列头
  ch [label="Channel", shape=box, fillcolor="#DCE9FB"];
  sm [label="PshStateMachine", shape=box, fillcolor="#DCE9FB"];
  hd [label="PshHandler", shape=box, fillcolor="#DCE9FB"];
  dev [label="PSH 设备", shape=box, fillcolor="#DCE9FB"];

  // 锚点
  a1 [shape=point, style=invis, width=0.01]; b1 [shape=point, style=invis, width=0.01]; c1 [shape=point, style=invis, width=0.01]; d1 [shape=point, style=invis, width=0.01];
  a2 [shape=point, style=invis, width=0.01]; b2 [shape=point, style=invis, width=0.01]; c2 [shape=point, style=invis, width=0.01]; d2 [shape=point, style=invis, width=0.01];
  a3 [shape=point, style=invis, width=0.01]; b3 [shape=point, style=invis, width=0.01]; c3 [shape=point, style=invis, width=0.01]; d3 [shape=point, style=invis, width=0.01];
  a4 [shape=point, style=invis, width=0.01]; b4 [shape=point, style=invis, width=0.01]; c4 [shape=point, style=invis, width=0.01]; d4 [shape=point, style=invis, width=0.01];

  // 生命线 ch
  ch -> a1 [style=solid, arrowhead=none];
  a1 -> a2 [style=solid, arrowhead=none];
  a2 -> a3 [style=solid, arrowhead=none];
  a3 -> a4 [style=solid, arrowhead=none];
  // 生命线 sm
  sm -> b1 [style=solid, arrowhead=none];
  b1 -> b2 [style=solid, arrowhead=none];
  b2 -> b3 [style=solid, arrowhead=none];
  b3 -> b4 [style=solid, arrowhead=none];
  // 生命线 hd
  hd -> c1 [style=solid, arrowhead=none];
  c1 -> c2 [style=solid, arrowhead=none];
  c2 -> c3 [style=solid, arrowhead=none];
  c3 -> c4 [style=solid, arrowhead=none];
  // 生命线 dev
  dev -> d1 [style=solid, arrowhead=none];
  d1 -> d2 [style=solid, arrowhead=none];
  d2 -> d3 [style=solid, arrowhead=none];
  d3 -> d4 [style=solid, arrowhead=none];

  // 阶段1：banner
  {rank=same; a1; b1; c1; d1;}
  a1 -> b1 [label="open() 返回 banner", dir=back];
  b1 -> c1 [label="start(banner)\nmatch profile", dir=back];
  {rank=same; a2; b2; c2; d2;}
  a2 -> d2 [style=dashed, color="#B0B0B0", arrowhead=none, label="阶段一：banner 匹配"];

  // 阶段2：detect
  {rank=same; a3; b3; c3; d3;}
  c1 -> b1 [label="LOCKED\n(锁定)", dir=back];
  b1 -> a1 [label="unlock()", dir=back];
  a1 -> d1 [label="write('debug')"];
  {rank=same; a4; b4; c4; d4;}
  d1 -> c1 [label="read()\n→ Challenge + Password:", dir=back];
  c1 -> b1 [label="onKeyRequest\n获取密钥", dir=back];
  b1 -> a1 [label="发送密钥", dir=back];
  a1 -> d1 [label="write(密钥)"];
  d1 -> c1 [label="read()\n→ Access Granted", dir=back];
  c1 -> b1 [label="READY\n解锁成功", dir=back];
  a4 -> d4 [style=dashed, color="#B0B0B0", arrowhead=none, label="阶段二：debug → 密钥 → 解锁"];
}
