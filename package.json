{
  "name": "@smai-kit/embedded-mcp-toolkit",
  "version": "1.4.0",
  "description": "MCP Server for remote management of embedded Linux boards via SSH",
  "type": "module",
  "main": "out/cli/index.js",
  "bin": {
    "embedded-mcp-toolkit": "./bin/embedded-mcp-toolkit-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:minify": "node scripts/minify.mjs",
    "clean:all": "npm run clean:out && npm run clean:exe && npm run clean:log",
    "clean:out": "rimraf out",
    "clean:exe": "rimraf exe-out",
    "clean:log": "rimraf --glob ./.embedded/log/**/*.log",
    "dev": "tsc --watch",
    "start": "node out/cli/index.js",
    "qemu:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-qemu-virt.ps1",
    "qemu:kill": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-qemu.ps1",
    "inspector": "npm run inspector:win",
    "inspector:win": "powershell -ExecutionPolicy Bypass -File scripts/run-inspector.ps1",
    "git-sync-force": "node scripts/sync-force.mjs",
    "cmd:sshd-config": "node ./bin/embedded-mcp-toolkit-cli.js sshd-config",
    "cmd:remote-mcp-config": "node ./bin/embedded-mcp-toolkit-cli.js remote-mcp-config",
    "format:check": "prettier ./src --check",
    "format:fix": "prettier ./src --write",
    "eslint:fix": "eslint --fix -c eslint.config.ts src",
    "pack:dry-run": "npm pack --dry-run",
    "pack:tgz": "npm pack",
    "pack:list": "tar -tzf smai-kit-embedded-mcp-toolkit-%npm_package_version%.tgz",
    "pack:project": "node scripts/pack-project.mjs",
    "pack:exe": "node scripts/build-exe.mjs",
    "pack:exe:win": "node scripts/build-exe.mjs --win",
    "gen:init-templates": "node scripts/gen-init-templates.mjs",
    "ccstatusline": "ccstatusline setup --config .claude/ccstatusline-settings.json",
    "win:node-list": "tasklist | findstr node.exe",
    "win:node-kill": "taskkill /f /im node.exe",
    "win:open-home": "start %USERPROFILE%",
    "win:open-devmgr": "devmgmt.msc",
    "win:open-netadapter": "ncpa.cpl",
    "win:open-node-global": "for /f \"delims=\" %d in ('npm root -g') do @start \"\" \"%d\"",
    "win:open-psprofile": "powershell -NoProfile -Command \"start $PROFILE\""
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "commander": "^14.0.3",
    "iconv-lite": "^0.7.3",
    "js-yaml": "^4.1.1",
    "serialport": "^13.0.0",
    "ssh2": "^1.16.0",
    "zmodem.js": "^0.1.10"
  },
  "devDependencies": {
    "@dimava/serialport-bindings-cpp": "13.0.2",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/inspector": "^0.18.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.0",
    "adm-zip": "^0.6.0",
    "ccstatusline": "^2.2.19",
    "esbuild": "^0.25.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
